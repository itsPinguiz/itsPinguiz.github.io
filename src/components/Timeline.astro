  {
    period: "2024 — Present",
    title: "M.Sc. in Data Science & Engineering",
    place: "Politecnico di Torino",
    description:
      "Advanced study across Machine Learning, Deep Learning, Big Data systems and the mathematical foundations of AI.",
  },
  {
    period: "Academic experience",
    title: "Human Activity Recognition internship",
    place: "Applied Machine Learning",
    description:
      "Worked on an end-to-end Human Activity Recognition pipeline, connecting sensor data, experimental design and model evaluation.",
  },
  {
    period: "Previous",
