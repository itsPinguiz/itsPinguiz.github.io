---
const entries = [
  {
    period: "2024 — Present",
    title: "M.Sc. in Computer Engineering — AI & Data Analytics",
    place: "Politecnico di Torino",
    description: "Coursework in Machine Learning, Deep Learning, Big Data systems and mathematics.",
  },
  {
    period: "Academic experience",
    title: "Human Activity Recognition internship",
    place: "University of Urbino Carlo Bo",
    description: "Developed a Human Activity Recognition pipeline using sensor data and model evaluation.",
  },
  {
    period: "Previous",
    title: "B.Sc. in Applied Computer Science",
    place: "University of Urbino Carlo Bo",
    description: "Studied software engineering, computer science and mathematics.",
  },
];
---

<ol class="timeline">
  {
    entries.map((entry, index) => (
      <li data-reveal>
        <span class="timeline-number">{String(index + 1).padStart(2, "0")}</span>
        <div class="timeline-period">{entry.period}</div>
        <div class="timeline-main">
          <p>{entry.place}</p>
          <h3>{entry.title}</h3>
          <span>{entry.description}</span>
        </div>
      </li>
    ))
  }
</ol>
