<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href="/#top" aria-label="Stefano Zizzi, back to homepage">
      <span class="wordmark-mark">SZ</span>
    </a>

    <div class="header-actions">
      <nav id="site-navigation" class="site-nav" aria-label="Primary navigation" data-menu>
        <a href="/#work">Work</a>
        <a href="/#about">About</a>
        <a href="/#community">Community</a>
        <a class="nav-contact" href="/#contact">Let’s talk <span aria-hidden="true">↗</span></a>
      </nav>

      <button class="theme-toggle" type="button" aria-label="Switch to dark mode" data-theme-toggle>
        <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.2 15.5A8.5 8.5 0 0 1 8.5 3.8 8.5 8.5 0 1 0 20.2 15.5Z" />
        </svg>
        <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
        <span data-theme-label>Dark mode</span>
      </button>

      <button
        class="menu-button"
        type="button"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="site-navigation"
        data-menu-button
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>
