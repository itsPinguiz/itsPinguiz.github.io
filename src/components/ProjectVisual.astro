---
interface Props {
  visual: "maas" | "clarity" | "eqe" | "minerva";
}

const { visual } = Astro.props;

const visualAssets = {
  maas: {
    src: "/projects/maas/attention-analysis.png",
    position: "center",
  },
  clarity: {
    src: "/projects/clarity/prompt-progression.png",
    position: "center",
  },
  eqe: {
    src: "/projects/eqe/ccc-by-k.png",
    position: "center 36%",
  },
} as const;

const asset = visual === "minerva" ? undefined : visualAssets[visual];
---

<div class:list={["project-visual", `project-visual--${visual}`]} aria-hidden="true">
  {
    asset ? (
      <img
        class="visual-image"
        src={asset.src}
        alt=""
        loading="lazy"
        style={`object-position: ${asset.position}`}
      />
    ) : (
      <div class="project-visual__placeholder">
        <span>Minerva</span>
        <small>Work in progress</small>
      </div>
    )
  }
</div>
