---
import type { CollectionEntry } from "astro:content";
import ProjectVisual from "./ProjectVisual.astro";

interface Props {
  project: CollectionEntry<"projects">;
  highlighted?: boolean;
}

const { project, highlighted = false } = Astro.props;
const projectPath = `/projects/${project.id.replace(/\.md$/, "")}`;
const {
  title,
  category,
  status,
  summary,
  contribution,
  result,
  resultLabel,
  evidenceUrl,
  evidenceLabel,
  technologies,
  visual,
} = project.data;
---

<article class:list={["project-card", highlighted && "project-card--highlighted"]} data-reveal>
  <ProjectVisual visual={visual} />

  <div class="project-card__content">
    <div class="project-card__meta">
      <p class="eyebrow">{category}</p>
      <span class:list={["status", status === "In Development" && "status--development"]}>{status}</span>
    </div>
    <h3><a href={projectPath}>{title}</a></h3>
    <p class="project-summary">{summary}</p>

    <p class="project-contribution"><span>Contribution</span>{contribution}</p>

    {
      result && (
        <div class="project-result">
          <span>{resultLabel ?? "Result"}</span>
          <p>{result}</p>
        </div>
      )
    }

    <div class="project-footer">
      <ul class="tech-list" aria-label="Technologies">
        {technologies.map((technology) => <li>{technology}</li>)}
      </ul>

      <div class="project-links">
        <a class="text-link" href={projectPath}>
          View case study <span aria-hidden="true">→</span>
        </a>
        {
          evidenceUrl && (
            <a
              class="text-link text-link--muted"
              href={evidenceUrl}
              target="_blank"
              rel="noreferrer"
            >
              {evidenceLabel} <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span>
            </a>
          )
        }
      </div>
    </div>
  </div>
</article>
