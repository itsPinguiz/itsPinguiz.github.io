---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Timeline from "../components/Timeline.astro";
import Footer from "../components/Footer.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);

const focusAreas = [
  {
    index: "01",
    title: "Computer Vision",
    description: "Semantic segmentation, OOD detection and multi-task visual learning.",
  },
  {
    index: "02",
    title: "NLP & LLMs",
    description: "Transformer encoders, prompted models and parameter-efficient fine-tuning.",
  },
  {
    index: "03",
    title: "Explainable AI",
    description: "Explanation faithfulness and evaluation with limited feature sets.",
  },
  {
    index: "04",
    title: "ML Engineering",
    description: "Experiment tracking, reproducibility and software interfaces.",
  },
];
---

<BaseLayout>
  <div id="top"></div>
  <Header />

  <main id="main-content">
    <section class="hero shell" aria-labelledby="hero-title">
      <div class="hero-copy" data-reveal data-visible>
        <p class="hero-kicker">Computer Engineering · Torino, Italy</p>
        <h1 id="hero-title">Stefano Zizzi</h1>
        <p class="hero-intro">
          I’m an M.Sc. student in Computer Engineering at Politecnico di Torino, specializing in
          Artificial Intelligence and Data Analytics. My projects cover computer vision, NLP and explainable AI.
        </p>
        <div class="hero-actions">
          <a class="button button--primary" href="#work">View selected work <span aria-hidden="true">↓</span></a>
          <a
            class="button button--secondary"
            href="/cv/stefano-zizzi-cv.pdf"
            download="stefano-zizzi-cv.pdf"
          >
            Download CV <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </section>

    <section id="work" class="section shell work-section" aria-labelledby="work-title">
      <div class="section-heading section-heading--single" data-reveal>
        <div>
          <p class="section-index">01 / Work</p>
          <h2 id="work-title">Selected projects</h2>
        </div>
      </div>

      <div class="projects-grid">
        {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
    </section>

    <section id="about" class="section section--ink" aria-labelledby="focus-title">
      <div class="shell">
        <div class="section-heading section-heading--light section-heading--single" data-reveal>
          <div>
            <p class="section-index">02 / Focus</p>
            <h2 id="focus-title">Technical areas</h2>
          </div>
        </div>

        <div class="focus-grid">
          {
            focusAreas.map((area) => (
              <article data-reveal>
                <div class="focus-top">
                  <span>{area.index}</span>
                </div>
                <h3>{area.title}</h3>
                <p>{area.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section shell journey-section" aria-labelledby="journey-title">
      <div class="section-heading section-heading--single" data-reveal>
        <div>
          <p class="section-index">03 / Background</p>
          <h2 id="journey-title">Education and experience</h2>
        </div>
      </div>
      <Timeline />
    </section>

    <section id="community" class="section shell community-section" aria-labelledby="community-title">
      <div class="community-card" data-reveal>
        <div class="community-copy">
          <p class="section-index">04 / Open Source & Community</p>
          <h2 id="community-title">Open source and university work</h2>
          <p>
            I contribute to InformaticaUniurb, a collection of Computer Science course notes for students at the
            University of Urbino.
          </p>
          <a
            class="button button--light"
            href="https://github.com/itsPinguiz/InformaticaUniurb"
            target="_blank"
            rel="noreferrer"
          >
            Explore InformaticaUniurb <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="community-stats">
          <div>
            <strong>20+</strong>
            <span>GitHub stars</span>
          </div>
          <div>
            <strong>9</strong>
            <span>Forks</span>
          </div>
          <div class="community-stat--wide">
            <strong>InformaticaUniurb</strong>
            <span>A collaborative collection of Computer Science course notes created for University of Urbino students.</span>
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="contact-section" aria-labelledby="contact-title">
      <div class="shell contact-inner" data-reveal>
        <p class="section-index">05 / Email and profiles</p>
        <h2 id="contact-title">Contact</h2>
        <p>
          I’m interested in research collaborations, internships and engineering work across Computer Vision,
          NLP and trustworthy AI.
        </p>
        <div class="contact-links">
          <a href="mailto:zizzi.stfn@gmail.com">
            <span>Email</span>
            <strong>zizzi.stfn@gmail.com</strong>
            <i aria-hidden="true">↗</i>
          </a>
          <a href="https://github.com/itsPinguiz" target="_blank" rel="noreferrer">
            <span>Code</span>
            <strong>github.com/itsPinguiz</strong>
            <i aria-hidden="true">↗</i>
          </a>
          <a href="https://www.linkedin.com/in/zizzi-stefano" target="_blank" rel="noreferrer">
            <span>Network</span>
            <strong>linkedin.com/in/zizzi-stefano</strong>
            <i aria-hidden="true">↗</i>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
